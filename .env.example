# ==============================================================================
# Finance Master Backend — Environment Variables Template
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/FinanceDB?retryWrites=true&w=majority

# Fallback UPI ID for Khata Payment Intents (e.g., merchant@upi)
DEFAULT_UPI_ID=
