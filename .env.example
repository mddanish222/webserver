# ==============================================================================
# Finance Master Environment Variables Example (Production & Development)
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/FinanceDB?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# Token Lifespan: Set to 'never' so user stays permanently logged in until manual logout
JWT_ACCESS_EXPIRY=never

# Default UPI ID fallback
DEFAULT_UPI_ID=
